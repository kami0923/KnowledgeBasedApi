{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=KnowledgeBaseDb;Integrated Security=True;Trust Server Certificate=True"
  },
  "Jwt": {
    "Issuer": "KnowledgeBaseAPI",
    "Audience": "KnowledgeBaseAPIUsers",
    "ExpiryMinutes": 60
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "Model": "gemini-3.5-flash-lite",
    "Temperature": 0.2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "FileStorage": {
    "RootPath": "UploadedFiles"
  },
  "AllowedHosts": "*"
}
